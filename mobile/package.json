{
  "name": "myllm-mobile",
  "version": "1.0.0",
  "description": "Application mobile iOS/Android de MIA (wrapper Capacitor — la WebView charge l'app web déployée)",
  "private": true,
  "scripts": {
    "sync": "cap sync",
    "sync:android": "cap sync android",
    "sync:ios": "cap sync ios",
    "run:android": "cap run android",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "build:android": "cd android && ./gradlew assembleRelease bundleRelease"
  },
  "dependencies": {
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/camera": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/network": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@capgo/capacitor-social-login": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "typescript": "^5.9.3"
  }
}
