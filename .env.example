# =============================================================================
# MIA — configuration d'environnement
# -----------------------------------------------------------------------------
# Copiez ce fichier vers `.env` et remplissez les valeurs, ou laissez
# `./install.sh` le générer pour vous (il tire les secrets au hasard et vérifie
# les prérequis avant d'écrire quoi que ce soit).
#
# Ce fichier est lu à DEUX endroits, ne l'oubliez pas en le modifiant :
#   - par `docker compose`, qui interpole les ${VARIABLES} des fichiers compose
#   - par `config/app.php`, pour une installation native sans Docker
#
# ATTENTION : aucune ligne ne doit être indentée, et pas de guillemets autour
# des valeurs — le lecteur de config/app.php ne les retire pas.
#
# Contrôle : `php scripts/doctor.php` liste ce qui manque encore.
# =============================================================================

# --- Mode d'installation -----------------------------------------------------
# Fichiers compose à assembler. Lue par docker compose LUI-MÊME : une fois
# renseignée, toute commande `docker compose …` fonctionne sans option -f.
#
#   Autonome (aucun proxy)  docker-compose.yml:docker/compose/db.yml:docker/compose/ports.yml
#   Derrière Traefik        docker-compose.yml:docker/compose/db.yml:docker/compose/traefik.yml
#   Développement local     …:docker/compose/ports.yml:docker/compose/dev.yml
#   Base MySQL externe      retirez docker/compose/db.yml et renseignez DB_HOST / DB_PORT
#
# Ne combinez JAMAIS ports.yml et traefik.yml : le port 80 de l'hôte est déjà
# celui de Traefik, et publier le conteneur l'exposerait hors TLS.
COMPOSE_FILE=docker-compose.yml:docker/compose/db.yml:docker/compose/ports.yml

# Nom de l'image construite. À changer si deux instances de MIA cohabitent sur
# la même machine, sans quoi elles se disputent le même tag.
#APP_IMAGE=mia-app:latest

# --- Adresse publique --------------------------------------------------------
# Adresse complète par laquelle les utilisateurs atteignent MIA. Sert aux
# redirections OAuth, aux liens absolus et au manifeste PWA : une valeur fausse
# casse la connexion Google sans message clair.
APP_URL=https://mia.exemple.fr
APP_ENV=production

# Nom d'hôte seul (sans schéma), utilisé UNIQUEMENT par les étiquettes Traefik.
# Inutile en mode autonome ou derrière un proxy tiers.
DOMAIN=mia.exemple.fr

# --- Secrets applicatifs -----------------------------------------------------
# Générer chacun avec : openssl rand -hex 32
# APP_SECRET     : signature des sessions.
# ENCRYPTION_KEY : chiffrement des clés API stockées en base. NE PLUS LA CHANGER
#                  une fois des clés enregistrées — elles deviendraient illisibles.
APP_SECRET=
ENCRYPTION_KEY=

# --- Base de données ---------------------------------------------------------
# Avec la base embarquée (cas par défaut), laissez DB_HOST=db : c'est le nom du
# service compose. Pour une base MySQL externe ou managée, renseignez son hôte
# et son port, et retirez le fichier de la base des services démarrés.
DB_HOST=db
DB_PORT=3306
DB_NAME=myllm
DB_USER=myllm
DB_PASS=
# Mot de passe root du serveur MySQL embarqué. Jamais lu par l'application :
# il ne sert qu'à initialiser le conteneur et à ses sauvegardes.
DB_ROOT_PASS=

# --- Compte de secours (optionnel, hérité) -----------------------------------
# Hash bcrypt permettant de se connecter avec un e-mail VIDE. Préférez un compte
# administrateur en base : php scripts/admin-create.php --email=vous@exemple.fr
#
# Si vous y tenez : docker compose interpole les « $ » de ce fichier. Doublez
# TOUS les « $ » du hash, sinon il arrive tronqué et la connexion répond
# « mot de passe invalide » sans autre explication.
#   $2y$12$abc…  s'écrit  $$2y$$12$$abc…
LOCAL_PASSWORD_HASH=

# --- Connexion Google (optionnel, repli) -------------------------------------
# Ces identifiants se saisissent désormais DANS L'APPLICATION :
#   Administration → Configuration → Authentification
# Les renseigner là-bas permet de les changer sans redéploiement, et le
# conteneur `worker` les voit forcément (ils vivent en base).
#
# Les variables ci-dessous restent lues en REPLI, pour ne rien casser sur une
# installation existante : une valeur saisie en administration l'emporte.
# Elles servent à « Se connecter avec Google » ET aux connecteurs personnels
# Drive / Gmail / Agenda.
#
# La connexion Microsoft (Entra), elle, se configure UNIQUEMENT dans
# l'application — aucune variable d'environnement.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://mia.exemple.fr/auth/callback
# Application mobile : client OAuth iOS (audience des jetons iOS). Vide = pas de
# connexion Google native sur iOS. Android réutilise GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID_IOS=

# --- Générations en arrière-plan (workers) ----------------------------------
# Nombre de workers : chacun mène une génération à la fois (réponse du chat,
# image, page web, synchronisation de base…). 4 par défaut. Comptez un worker
# pour 3 à 5 personnes qui conversent en même temps ; un worker occupe ~25 Mo
# de mémoire au repos. Nombre entier ; 0 = aucun worker (l'application exécute
# alors les générations elle-même, plus lentement).
# Pris en compte au prochain `docker compose up -d` (ou déploiement).
#MIA_WORKERS=4

# --- Base vectorielle Qdrant -------------------------------------------------
# Vide = http://qdrant:6333, le service compose embarqué.
# Installation native hors Docker : http://localhost:6333
QDRANT_URL=
# Répertoire de stockage de Qdrant, pour la mesure exacte de l'empreinte disque
# du tableau de bord. Vide = /qdrant-data (le volume monté en lecture seule).
QDRANT_DATA_PATH=

# --- Publication du service (modes autonome, proxy tiers, développement) -----
# Port de l'hôte sur lequel MIA est publiée. Sans effet en mode Traefik, qui ne
# publie aucun port (le proxy joint le conteneur par le réseau Docker).
#APP_PORT=8080
# Interface d'écoute. 0.0.0.0 = joignable depuis l'extérieur. Derrière un
# nginx/Caddy installé sur la MÊME machine, mettez 127.0.0.1 : le proxy y accède,
# personne d'autre.
#APP_BIND=0.0.0.0
# Port local du tableau de bord Qdrant (toujours lié à 127.0.0.1 : il n'a aucune
# authentification).
#QDRANT_PORT=6333

# --- Derrière un reverse-proxy tiers (nginx, Caddy, HAProxy) -----------------
# À 1 UNIQUEMENT si un proxy de CONFIANCE termine le TLS devant MIA : autorise
# la dérivation du cookie « Secure » depuis l'en-tête X-Forwarded-Proto. Sans
# proxy devant, n'importe quel client pourrait forger cet en-tête.
#TRUSTED_PROXY=0

# --- Traefik (uniquement si vous passez par docker-compose.prod.yml) ---------
# Toutes ces variables ont une valeur par défaut ; ne les renseignez que si
# votre installation Traefik s'écarte de la convention.
#TRAEFIK_NETWORK=ubuntu_default
#TRAEFIK_ROUTER=myllm
#TRAEFIK_ENTRYPOINT_HTTP=web
#TRAEFIK_ENTRYPOINT_HTTPS=web-secure
#TRAEFIK_CERTRESOLVER=le
